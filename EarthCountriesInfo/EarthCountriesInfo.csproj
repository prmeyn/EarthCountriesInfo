<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>EarthCountriesInfo</PackageId>
    <Authors>prmeyn</Authors>
    <Description>Information about the countries of planet Earth: country names in many languages, international dialling codes, and valid phone number lengths with display formats.</Description>
    <PackageTags>countries;country;iso3166;localization;i18n;phone;dialling-code</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/prmeyn/EarthCountriesInfo</PackageProjectUrl>
    <RepositoryUrl>https://github.com/prmeyn/EarthCountriesInfo</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HumanLanguages" Version="11.0.0" />

	<None Include="../LICENSE" Pack="true" PackagePath="\" />
	<None Include="../README.md" Pack="true" PackagePath="\" />
	<!-- Unicode-3.0 requires its notice to travel with the data or the documentation. -->
	<None Include="../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
